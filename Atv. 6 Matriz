programa
{
	inclua biblioteca Util --> ut
	
	funcao inicio()
	{
//Faça um preenchimento aleatório de uma matriz 3x3. Ao final, mostre os elementos que foram preenchidos.

		inteiro Matriz[3][3] , linha, coluna, preencher
		
		para (linha=0;linha<3;linha++){

			para(coluna=0;coluna<3;coluna++){
				
				preencher = ut.sorteia(1, 100)
				Matriz[linha][coluna] = preencher
			
			}
			
		}
	}
}
