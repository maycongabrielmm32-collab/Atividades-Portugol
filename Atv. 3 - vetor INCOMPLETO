programa
{
// Leia 15 números entre 1 e 10 (valores fora desse intervalo não devem ser armazenados e o valor de entrada deve ser pedido novamente até que esteja
// nesse intervalo). Ao final, mostre quantas vezes cada número apareceu.
	funcao inicio()
	{
		real numeros[15], comparar[15] , somas[15]
		inteiro i
		para(i=0;i<15;i++){

			faca{
				escreva("Digite valores de 1 a 10: ")
				leia(numeros[i])
				comparar[i] = numeros[i]
				
				se(numeros[i]<1 ou numeros[i]>10){
					escreva("\nNúmero Incorreto! ")
				}
			}enquanto(numeros[i]<1 ou numeros[i]>10)

			para(i=14;i>-1;i--){
				somas[i] = comparar[i]==numeros[i]
				 
			}
		}

	}
}
