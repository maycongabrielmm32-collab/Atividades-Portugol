programa
{
//Preencha uma matriz 4x4 e exiba apenas os elementos da diagonal principal.
	funcao matriz(inteiro m[][]){
		inteiro l, c
			para(l=0 ; l<4 ; l++){
				
				para(c=0; c<4; c++){
				
					se(l==c){
						m[l][c] = 1
				
					}senao{
						m[l][c] = 0
					}		
				}
			}
	}
	
	funcao inicio()
	{

		inteiro m[4][4]
		matriz(m)
		
	}
}
